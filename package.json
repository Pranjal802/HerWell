{
  "name": "herwell",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "node --test server/src/*.test.js client/src/lib/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "sharp": "^0.35.5"
  }
}
