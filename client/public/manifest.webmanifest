    }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/", "icons": [{ "src": "/herwell-icon.svg", "sizes": "any" }] },
    { "name": "Add reminder", "url": "/reminders", "icons": [{ "src": "/herwell-icon.svg", "sizes": "any" }] },
    { "name": "Check-in", "url": "/wellness", "icons": [{ "src": "/herwell-icon.svg", "sizes": "any" }] }
  ]
}
